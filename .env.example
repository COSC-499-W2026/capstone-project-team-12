# Copy to .env for local development. Never commit .env.
APP_ENV=development
POSTGRES_USER=hunt
POSTGRES_PASSWORD=hunt
POSTGRES_DB=hunt
SECRET_KEY=change-me
# Email: docker compose points SMTP_HOST at Mailpit (http://localhost:8025).
# A real provider also needs SMTP_STARTTLS=true, SMTP_USERNAME and SMTP_PASSWORD.
MAIL_FROM=Hunt <no-reply@localhost>
APP_BASE_URL=http://localhost:5173
