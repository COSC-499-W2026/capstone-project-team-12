# Copy to .env for local development. Never commit .env.
APP_ENV=development
POSTGRES_USER=hunt
POSTGRES_PASSWORD=hunt
POSTGRES_DB=hunt
SECRET_KEY=change-me
# Email: docker compose points SMTP_HOST at Mailpit (http://localhost:8025).
# A real provider also needs SMTP_STARTTLS=true, SMTP_USERNAME and SMTP_PASSWORD.
MAIL_FROM=Hunt <no-reply@localhost>
APP_BASE_URL=http://localhost:5173
ACCESS_TOKEN_SECRET_KEY=change-me
# Refresh cookie: secure everywhere but development unless set. false only for staging over http.
# COOKIE_SECURE=
# Addresses uvicorn trusts for X-Forwarded-For, so rate limits see the real client IP.
# Behind nginx, use the one address nginx connects from, never a subnet or "*" (README, "Behind a reverse proxy").
FORWARDED_ALLOW_IPS=127.0.0.1

# Game rules (defaults in src/backend/app/config.py)
APP_TIMEZONE=America/Vancouver
SESSION_IDLE_EXPIRY_HOURS=24
EXPIRE_SESSIONS_MAX_BATCHES=20
