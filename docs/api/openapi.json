{
  "openapi": "3.1.0",
  "info": {
    "title": "Japanese Scavenger Hunt Game API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "register"
        ],
        "summary": "Register",
        "description": "Student sign-up: email, username, password, optional access code.",
        "operationId": "registerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Registeruser"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/{key}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Get Media File",
        "description": "Send a media file through a link made by StorageService.signed_url.\n\nNo access token: audio players and image tags cannot send one, so the signature is the\npermission. 403 FORBIDDEN for a tampered or expired link, 404 NOT_FOUND once the file is gone.",
        "operationId": "getMediaFile",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          },
          {
            "name": "expires",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Expires"
            }
          },
          {
            "name": "sig",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sig"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/teacher/classes": {
      "get": {
        "tags": [
          "teacher-classes"
        ],
        "summary": "List classrooms for a teacher or TA",
        "description": "Return classrooms owned or assisted by the authenticated user.",
        "operationId": "listTeacherClasses",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClassListItem"
                  },
                  "type": "array",
                  "title": "Response Listteacherclasses"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "teacher-classes"
        ],
        "summary": "Create a classroom",
        "description": "Create a classroom with a fixed target language, assign the creator as owner, and generate an initial access code.",
        "operationId": "createClass",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClassRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateClassResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/teacher/classes/{class_id}": {
      "patch": {
        "tags": [
          "teacher-classes"
        ],
        "summary": "Update classroom settings",
        "description": "Allow the classroom owner to update the name and leaderboard setting. The target language cannot be changed.",
        "operationId": "updateClass",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Class Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateClassRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateClassResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/teacher/classes/{class_id}/access-codes": {
      "post": {
        "tags": [
          "teacher-classes"
        ],
        "summary": "Create a classroom access code",
        "description": "Allow a classroom owner or teaching assistant to generate an additional access code with optional expiration and usage limits.",
        "operationId": "createAccessCode",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Class Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccessCodeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessCodeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/teacher/access-codes/{code_id}": {
      "patch": {
        "tags": [
          "teacher-access-codes"
        ],
        "summary": "Deactivate an access code",
        "description": "Allow a classroom owner or teaching assistant to deactivate an existing access code.",
        "operationId": "updateAccessCode",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "code_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Code Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAccessCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessCodeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness check used by Docker and CI. Does not touch the database.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Gethealth"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessCodeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "class_id": {
            "type": "string",
            "format": "uuid",
            "title": "Class Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "max_uses": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Uses"
          },
          "uses_count": {
            "type": "integer",
            "title": "Uses Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "class_id",
          "code",
          "expires_at",
          "is_active",
          "max_uses",
          "uses_count"
        ],
        "title": "AccessCodeResponse"
      },
      "ClassListItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "semester": {
            "type": "string",
            "title": "Semester"
          },
          "target_language": {
            "$ref": "#/components/schemas/Language"
          },
          "leaderboard_enabled": {
            "type": "boolean",
            "title": "Leaderboard Enabled"
          },
          "archived_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "staff_role": {
            "$ref": "#/components/schemas/ClassStaffRole"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "semester",
          "target_language",
          "leaderboard_enabled",
          "archived_at",
          "staff_role"
        ],
        "title": "ClassListItem"
      },
      "ClassStaffRole": {
        "type": "string",
        "enum": [
          "owner",
          "assistant"
        ],
        "title": "ClassStaffRole"
      },
      "CreateAccessCodeRequest": {
        "properties": {
          "max_uses": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Uses"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "title": "CreateAccessCodeRequest"
      },
      "CreateClassRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "semester": {
            "type": "string",
            "pattern": "^[0-9]{4}(W1|W2|S1|S2)$",
            "title": "Semester"
          },
          "target_language": {
            "$ref": "#/components/schemas/Language"
          }
        },
        "type": "object",
        "required": [
          "name",
          "semester",
          "target_language"
        ],
        "title": "CreateClassRequest"
      },
      "CreateClassResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "semester": {
            "type": "string",
            "title": "Semester"
          },
          "target_language": {
            "$ref": "#/components/schemas/Language"
          },
          "access_code": {
            "type": "string",
            "title": "Access Code"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "semester",
          "target_language",
          "access_code"
        ],
        "title": "CreateClassResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {},
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_CREDENTIALS",
          "INVALID_ACCESS_CODE",
          "USERNAME_TAKEN",
          "EMAIL_TAKEN",
          "ALREADY_IN_CLASS_FOR_LANGUAGE",
          "TA_SAME_CLASS_CONFLICT",
          "SESSION_ALREADY_OPEN",
          "NOT_ENOUGH_CONTENT",
          "SESSION_NOT_ACTIVE",
          "INVALID_STAGE",
          "NOT_WITHIN_RADIUS",
          "STALE_POSITION",
          "ATTEMPTS_EXHAUSTED",
          "SHUFFLE_LIMIT_REACHED",
          "RESET_LIMIT_REACHED",
          "GPS_OVERRIDE_NOT_ALLOWED",
          "STATE_CHANGED",
          "ACCOUNT_DISABLED",
          "REMOVED_FROM_CLASS",
          "CLASS_ARCHIVED",
          "FORBIDDEN_ROLE",
          "UPLOAD_IN_PROGRESS",
          "ALREADY_REPORTED",
          "IDEMPOTENCY_KEY_REUSED",
          "INVALID_TOKEN",
          "FILE_TOO_LARGE",
          "AUDIO_TOO_LONG",
          "USER_NOT_FOUND",
          "LEADERBOARD_DISABLED",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMITED",
          "OCR_BUSY",
          "VALIDATION_ERROR",
          "NOT_AUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "The body of every error response, the same shape as AppError.body() (for OpenAPI)."
      },
      "Language": {
        "type": "string",
        "enum": [
          "ja",
          "zh",
          "fr",
          "de",
          "ko",
          "es"
        ],
        "title": "Language"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "access_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Code"
          }
        },
        "type": "object",
        "required": [
          "email",
          "username",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "UpdateAccessCodeRequest": {
        "properties": {
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": false
          }
        },
        "type": "object",
        "title": "UpdateAccessCodeRequest"
      },
      "UpdateClassRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "leaderboard_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leaderboard Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UpdateClassRequest"
      },
      "UpdateClassResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "semester": {
            "type": "string",
            "title": "Semester"
          },
          "target_language": {
            "$ref": "#/components/schemas/Language"
          },
          "leaderboard_enabled": {
            "type": "boolean",
            "title": "Leaderboard Enabled"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "semester",
          "target_language",
          "leaderboard_enabled"
        ],
        "title": "UpdateClassResponse"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "login"
          }
        }
      }
    }
  }
}
