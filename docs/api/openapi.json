{
  "openapi": "3.1.0",
  "info": {
    "title": "Japanese Scavenger Hunt Game API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "register"
        ],
        "summary": "Register",
        "description": "Student sign-up: email, username, password, optional access code.",
        "operationId": "registerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Registeruser"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/classes": {
      "post": {
        "tags": [
          "classes"
        ],
        "summary": "Create a classroom",
        "description": "Create a classroom with a fixed target language and generate its initial eight-character access code. Only active staff accounts may create classrooms. The classroom, owner assignment, and initial access code are saved in one transaction.",
        "operationId": "createClass",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClassRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateClassResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/me/classes/join": {
      "post": {
        "tags": [
          "classes"
        ],
        "summary": "Join a classroom",
        "description": "Enrol the authenticated student using a classroom access code. A student may have only one active classroom per language. Students who voluntarily left may rejoin, but students removed by a teacher cannot. Teachers cannot join as students, and teaching assistants cannot join classes they assist. Successful enrolment also makes it the student's current class. Repeating a successful request with the original access code returns success without consuming another use, even if the code has expired or reached its usage limit. Deactivated codes are rejected.",
        "operationId": "joinClass",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinClassRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinClassResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/me/classes/{class_id}/leave": {
      "post": {
        "tags": [
          "classes"
        ],
        "summary": "Leave a classroom",
        "description": "Leave an actively enrolled classroom. The student may rejoin later using a valid access code. If this was the student's current class, another active class is selected when available; otherwise, the selection is cleared. Leaving ends any open (active or paused) class game sessions.",
        "operationId": "leaveClass",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Class Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Post Verify Email",
        "description": "Confirm the address with the token from the verification email (400 INVALID_TOKEN).",
        "operationId": "verifyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Post Resend Verification",
        "description": "Send the link again. Same answer whether or not the address has an account.",
        "operationId": "resendVerificationEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Post Forgot Password",
        "description": "Queue a reset email. Same answer whether or not the address has an account.",
        "operationId": "requestPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Post Reset Password",
        "description": "Set a new password with the token from the reset email (400 INVALID_TOKEN, 422).",
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/games": {
      "post": {
        "tags": [
          "games"
        ],
        "summary": "Start New Game",
        "description": "Start a class game (`class_id`) or a Practice game (`language`).\n\nSend exactly one of them. The game gets 5 different locations in the language. Locations the\nstudent has not completed yet come first. After a quit the same day, the locations that were\nnot played carry over to the new game, but not after a reset. Names, rooms and coordinates\nare never sent, only the first clue's audio link.\n\n409 SESSION_ALREADY_OPEN if the student has an active or paused game (its id is in `details`),\nunless it has been idle for 24 hours, then it is expired and the new game starts. If the new\ngame then fails (e.g. NOT_ENOUGH_CONTENT), nothing is committed, so the expiry is rolled back\nand the old game stays open until the next start or the expiry job.\n409 NOT_ENOUGH_CONTENT if the language has fewer than 5 locations to draw.\n409 CLASS_ARCHIVED for a student whose enrolment ended when the class was archived.\n404 NOT_FOUND for a class the student is not in, or if the first clue has no recording (also\nin a Practice game). 403 FORBIDDEN_ROLE for an admin, ACCOUNT_DISABLED for a disabled account.",
        "operationId": "startGame",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartGameResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/media/{key}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Get Media File",
        "description": "Send a media file through a link made by StorageService.signed_url.\n\nNo access token: audio players and image tags cannot send one, so the signature is the\npermission. 403 FORBIDDEN for a tampered or expired link, 404 NOT_FOUND once the file is gone.",
        "operationId": "getMediaFile",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          },
          {
            "name": "expires",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Expires"
            }
          },
          {
            "name": "sig",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sig"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness check used by Docker and CI. Does not touch the database.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Gethealth"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateClassRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "description": "Classroom name.",
            "examples": [
              "JAPN 101 - Fall 2026"
            ]
          },
          "semester": {
            "type": "string",
            "pattern": "^[0-9]{4}(W1|W2|S1|S2)$",
            "title": "Semester",
            "description": "Academic semester identifier.",
            "examples": [
              "2026W1"
            ]
          },
          "language": {
            "$ref": "#/components/schemas/Language",
            "description": "Fixed target language for the classroom."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "Timezone-aware expiration for the initial access code."
          },
          "max_uses": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Uses",
            "description": "Optional maximum number of uses for the initial access code."
          }
        },
        "type": "object",
        "required": [
          "name",
          "semester",
          "language",
          "expires_at"
        ],
        "title": "CreateClassRequest",
        "description": "Details for a new classroom and its initial access code."
      },
      "CreateClassResponse": {
        "properties": {
          "class_id": {
            "type": "string",
            "format": "uuid",
            "title": "Class Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "semester": {
            "type": "string",
            "title": "Semester"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "access_code": {
            "type": "string",
            "title": "Access Code"
          }
        },
        "type": "object",
        "required": [
          "class_id",
          "name",
          "semester",
          "language",
          "access_code"
        ],
        "title": "CreateClassResponse",
        "description": "Created classroom and its initial enrolment code."
      },
      "Difficulty": {
        "type": "integer",
        "enum": [
          1,
          2,
          3
        ],
        "title": "Difficulty"
      },
      "EmailRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "EmailRequest"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {},
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_CREDENTIALS",
          "INVALID_ACCESS_CODE",
          "USERNAME_TAKEN",
          "EMAIL_TAKEN",
          "ALREADY_IN_CLASS_FOR_LANGUAGE",
          "TA_SAME_CLASS_CONFLICT",
          "SESSION_ALREADY_OPEN",
          "NOT_ENOUGH_CONTENT",
          "SESSION_NOT_ACTIVE",
          "INVALID_STAGE",
          "NOT_WITHIN_RADIUS",
          "STALE_POSITION",
          "ATTEMPTS_EXHAUSTED",
          "SHUFFLE_LIMIT_REACHED",
          "RESET_LIMIT_REACHED",
          "GPS_OVERRIDE_NOT_ALLOWED",
          "STATE_CHANGED",
          "ACCOUNT_DISABLED",
          "REMOVED_FROM_CLASS",
          "CLASS_ARCHIVED",
          "FORBIDDEN_ROLE",
          "UPLOAD_IN_PROGRESS",
          "ALREADY_REPORTED",
          "IDEMPOTENCY_KEY_REUSED",
          "INVALID_TOKEN",
          "FILE_TOO_LARGE",
          "AUDIO_TOO_LONG",
          "USER_NOT_FOUND",
          "LEADERBOARD_DISABLED",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMITED",
          "OCR_BUSY",
          "VALIDATION_ERROR",
          "NOT_AUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "The body of every error response, the same shape as AppError.body() (for OpenAPI)."
      },
      "JoinClassRequest": {
        "properties": {
          "access_code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Access Code",
            "description": "Eight-character classroom access code. Spaces and hyphens are accepted.",
            "examples": [
              "K7PM-3QXD"
            ]
          }
        },
        "type": "object",
        "required": [
          "access_code"
        ],
        "title": "JoinClassRequest",
        "description": "Access code provided by a student joining a classroom."
      },
      "JoinClassResponse": {
        "properties": {
          "class_id": {
            "type": "string",
            "format": "uuid",
            "title": "Class Id"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          }
        },
        "type": "object",
        "required": [
          "class_id",
          "language"
        ],
        "title": "JoinClassResponse",
        "description": "Classroom selected after successful enrolment."
      },
      "Language": {
        "type": "string",
        "enum": [
          "ja",
          "zh",
          "fr",
          "de",
          "ko",
          "es"
        ],
        "title": "Language"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "access_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Code"
          }
        },
        "type": "object",
        "required": [
          "email",
          "username",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "ResetPasswordRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Token"
          },
          "new_password": {
            "type": "string",
            "maxLength": 200,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "new_password"
        ],
        "title": "ResetPasswordRequest"
      },
      "SessionState": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "completed",
          "abandoned"
        ],
        "title": "SessionState"
      },
      "StartGameRequest": {
        "properties": {
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "class_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Class Id"
          },
          "language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
